# Copy to .env and fill in. `orq setup --local` can mint ORQ_API_KEY for you.
ORQ_API_KEY=
# Base URL of your orq instance. Leave as is for orq cloud; change for on-prem.
ORQ_BASE_URL=https://my.orq.ai
# Project every workshop entity is created in (agents, KBs, evaluators, rules).
ORQ_PROJECT=orq-workshop
# Prefix for every entity key this repo creates, so `make reset` can find and delete them.
WS_PREFIX=ws
# Chat model for the refund agent. Must be provider/model. Avoid reasoning models on /chat/completions with tools.
MODEL=openai/gpt-4o-mini
# Cheap non-reasoning judge for evaluators.
JUDGE_MODEL=openai/gpt-4o-mini
# Embedding model for the knowledge base. text-embedding-3-small returned 500 on vector search in Sep 2026; large works.
EMBEDDING_MODEL=openai/text-embedding-3-large
# Identity + thread attached to every call so traces group per customer and conversation.
IDENTITY_ID=customer-user_001
# Tracing mode for the local agent: gateway (zero-code) or otel (adds @traced spans).
TRACING=gateway
# orqi is alpha. Pin a release tag so the workshop does not break mid-session.
ORQI_VERSION=0.1.0
# `orq connect` writes an MCP entry named MCP_CLIENT_NAME (default orq-workspace) into your coding agent config.
# Public URL of app/mcp_server.py (instructor deploys before module 10).
MCP_SERVER_URL=
