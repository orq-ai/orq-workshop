# Copy to .env and fill in. `orq setup --local` can mint ORQ_API_KEY for you.
ORQ_API_KEY=
# Base URL of your orq instance. Leave as is for orq cloud; change for on-prem.
ORQ_BASE_URL=https://my.orq.ai
# Project every workshop entity is created in (agents, KBs, evaluators, rules).
ORQ_PROJECT=orq-workshop
# Your workspace key (`active_workspace_key` in `orq doctor`). Only `make chat` uses it, to link each answer to its trace.
ORQ_WORKSPACE=
# Your seat prefix: every entity key this repo creates starts with it, so `make reset` deletes only yours.
# Use the one from your workshop email (e.g. ws07), or pick your own. Lowercase; `make reset` refuses the bare `ws`.
# This file beats shell exports (load_dotenv override=True), so edit it here.
WS_PREFIX=ws00
# Model for the refund agent, provider/model. The app uses the Responses API; GPT-5.x rejects `tools` on /chat/completions unless reasoning_effort is "none".
MODEL=openai/gpt-6-luna
# Cheap non-reasoning judge for evaluators and the simulator.
JUDGE_MODEL=openai/gpt-6-luna
# Embedding model for the knowledge base. text-embedding-3-small returned 500 on vector search in Sep 2026; large works.
EMBEDDING_MODEL=openai/text-embedding-3-large
# Models evaluatorq's `eq` CLI uses (red team, simulation, insights). Its smart default is openai/gpt-6-sol;
# every model named here must be enabled in your workspace. The classifier answers Insights label questions.
EVALUATORQ_FAST_MODEL=openai/gpt-6-luna
EVALUATORQ_SMART_MODEL=openai/gpt-6-luna
EVALUATORQ_CLASSIFIER_MODEL=typesafe/jev-latest
EVALUATORQ_EMBEDDING_MODEL=openai/text-embedding-3-large
# Identity + thread attached to every call so traces group per customer and conversation.
IDENTITY_ID=customer-user_001
# Tracing mode for the local agent: gateway (zero-code) or otel (adds @traced spans).
TRACING=gateway
# `orq connect` writes an MCP entry named MCP_CLIENT_NAME (default orq-workspace) into your coding agent config.
# Public URL of app/mcp_server.py (instructor deploys before module 10).
MCP_SERVER_URL=
# Modules 09 and 14: the public URL of app/edge.py (`make edge` + `npx localtunnel --port 8001`, or the
# instance the instructor hosts). Module 09 registers <WS_EDGE_URL>/search as an external knowledge base,
# module 14 delivers webhook events to <WS_EDGE_URL>/<WS_PREFIX>. Unset: module 09 prints the contract only,
# module 14 delivers to httpbin.
WS_EDGE_URL=
# Module 14 only: override the webhook delivery URL (default <WS_EDGE_URL>/<WS_PREFIX>, else httpbin).
# httpbin accepts the POSTs but stores nothing.
WS_WEBHOOK_URL=https://httpbin.org/post
# One shared secret: orq signs webhook bodies with it and sends it as the external KB's Bearer token: `orq webhooks generate-secret -o json | jq -r .secret`.
WS_WEBHOOK_SECRET=
