# Copy to toqan-chat/.env. Project API key of the Toqan workspace (never commit it).
TOQAN_API_KEY=
# Regional base URL of the router; the app calls <base>/v3/router and <base>/v2/models.
TOQAN_BASE_URL=https://router.toqan.ai/br
# Workspace slug in Studio URLs, for the "Ver no Toqan" trace links.
TOQAN_WORKSPACE=toqan
