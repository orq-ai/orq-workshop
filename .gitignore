# Credentials: .env and any copy of it (.env.local, .env.bak, ...). Only the template is tracked.
.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
site/
slides/*.html
slides/*.pdf
.evaluatorq/
# FastHTML session key, written into the repo root by `eq dashboard` (the simulation and red-teaming modules)
.sesskey
evals/results/
modules/**/reports/
.context/
.DS_Store
node_modules/
modules/**/notebook.ipynb
.ipynb_checkpoints/
.playwright-mcp/
.proof-screens/
# installed by `orq connect` (the coding-agents module): symlinks into ~/.orq/snapshot and per-agent MCP config
.claude/
.agents/
.kimi-code/
.mcp.json
.superpowers/
